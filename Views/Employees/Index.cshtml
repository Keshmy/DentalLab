@model IEnumerable<Employee>
@{ ViewData["Title"] = "الموظفون"; }
<partial name="Partial/_datatables-css" />
<div class="d-flex justify-content-between mb-3">
    <h3>الموظفون</h3>
    <a asp-action="CreateEmployee" class="btn btn-primary">موظف جديد</a>
</div>
<table id="table1" class="table table-striped table-bordered w-100">
    <thead><tr><th>الاسم</th><th>الهاتف</th><th>التخصص</th><th>البريد</th><th>الموافقة</th></tr></thead>
    <tbody>
    @foreach (var e in Model)
    {
        <tr>
            <td><a asp-action="EditEmployee" asp-route-id="@e.Id">@e.Name</a></td>
            <td>@e.WorkPhone</td>
            <td>@e.Specialization</td>
            <td>@e.ApplicationUser?.Email</td>
            <td>
                <a asp-action="ChangeEmployeeApproval" asp-route-userId="@e.UserId" class="btn btn-sm @(e.ApplicationUser?.Approval == true ? "btn-success" : "btn-outline-warning")">
                    @(e.ApplicationUser?.Approval == true ? "موافق" : "بانتظار الموافقة")
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>
@section Scripts { <partial name="Partial/_datatables-js" /> }
