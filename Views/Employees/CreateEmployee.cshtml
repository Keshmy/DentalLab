@model CreateEmployeeVM
@{ ViewData["Title"] = "موظف جديد"; }
<form asp-action="CreateEmployee" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Age"></label><input asp-for="Age" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Employee.Name"></label><input asp-for="Employee.Name" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Employee.WorkPhone"></label><input asp-for="Employee.WorkPhone" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Employee.Address"></label><input asp-for="Employee.Address" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Employee.YearsOfExperience"></label><input asp-for="Employee.YearsOfExperience" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Employee.Specialization"></label><input asp-for="Employee.Specialization" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Employee.Bio"></label><textarea asp-for="Employee.Bio" class="form-control"></textarea></div>
    <button class="btn btn-primary">إنشاء</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
