@model ClinicCreditEntry
@{
    ViewData["Title"] = "قيد رصيد دائن";
}

<h4 class="mb-3">إضافة رصيد دائن يدوياً</h4>

<div class="alert alert-info">
    استخدم هذا النموذج لإضافة رصيد دائن غير مرتبط بحالة.
    لإلغاء حالة مدفوعة، الأفضل تسجيل الرصيد من شاشة الحالة عند اختيار حالة «ملغي».
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="card mb-3">
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label asp-for="ClinicId" class="form-label required"></label>
                <select asp-for="ClinicId" class="form-select" asp-items="ViewBag.Clinics">
                    <option value="">— اختر العيادة —</option>
                </select>
                <span asp-validation-for="ClinicId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Amount" class="form-label required"></label>
                <input asp-for="Amount" type="number" inputmode="decimal" step="0.01" min="0.01" class="form-control js-money" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="col-md-12">
                <label asp-for="Notes" class="form-label"></label>
                <input asp-for="Notes" class="form-control" />
            </div>
        </div>
    </div>

    <div class="mb-4">
        <button class="btn btn-primary px-5">حفظ</button>
        <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
