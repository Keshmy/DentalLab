@model IEnumerable<Expense>
@{
    ViewData["Title"] = "المصاريف";
    var monthNames = new[] { "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    var rows = Model ?? Enumerable.Empty<Expense>();
    var total = rows.Sum(e => e.Amount);
    var paid = rows.Where(e => e.IsPaid).Sum(e => e.Amount);
    var unpaid = total - paid;
}
<partial name="Partial/_datatables-css" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">المصاريف</h3>
    <a asp-action="Create" class="btn btn-primary">مصروف جديد</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <select name="year" class="form-select" asp-items="ViewBag.Years">
            <option value="">كل السنوات</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="month" class="form-select">
            <option value="">كل الأشهر</option>
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@((int?)ViewBag.Month == m)">@monthNames[m - 1]</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
            <option value="">كل البنود</option>
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-center">
        <div class="form-check">
            <input type="checkbox" name="unpaidOnly" value="true" class="form-check-input" id="unpaidOnly" checked="@((bool?)ViewBag.UnpaidOnly == true)" />
            <label class="form-check-label" for="unpaidOnly">غير المدفوع فقط</label>
        </div>
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-primary">تصفية</button>
        <a asp-action="Index" class="btn btn-outline-secondary">إعادة</a>
    </div>
</form>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">عدد الأسطر</div>
            <div class="fs-5 fw-bold">@rows.Count()</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">إجمالي المصاريف</div>
            <div class="fs-5 fw-bold">@total.ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card border-success"><div class="card-body py-2">
            <div class="small text-muted">المدفوع</div>
            <div class="fs-5 fw-bold text-success">@paid.ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card border-warning"><div class="card-body py-2">
            <div class="small text-muted">غير المدفوع</div>
            <div class="fs-5 fw-bold text-warning">@unpaid.ToString("N2")</div>
        </div></div>
    </div>
</div>

<table id="table1" class="table table-striped table-bordered table-hover w-100">
    <thead>
        <tr>
            <th>التاريخ</th>
            <th>البيان</th>
            <th>البند</th>
            <th>المبلغ</th>
            <th>الحساب</th>
            <th>مدفوع؟</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in rows)
        {
            <tr class="@(e.IsPaid ? "" : "table-warning")">
                <td>@(e.Date?.ToString("yyyy/M/d") ?? $"{e.Year}/{e.Month}")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@e.Id">@e.Description</a>
                    @if (!e.IsPaid)
                    {
                        <span class="badge bg-warning text-dark">غير مدفوع</span>
                    }
                </td>
                <td>@e.ExpenseCategory?.Name</td>
                <td data-order="@e.Amount">@e.Amount.ToString("N2")</td>
                <td>@e.FinancialAccount?.Name</td>
                <td>
                    @if (e.IsPaid)
                    {
                        <span class="badge bg-success">مدفوع</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">لا</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">تعديل</a>
                    <form asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline" onsubmit="return confirm('حذف؟');">
                        <button class="btn btn-sm btn-outline-danger">حذف</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="Partial/_datatables-js" />
}
