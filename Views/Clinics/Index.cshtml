@model IEnumerable<Clinic>
@{ ViewData["Title"] = "العيادات"; }
<partial name="Partial/_datatables-css" />
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">العيادات</h3>
    <div>
        @if (User.IsInRole("Prog") || User.IsInRole("Admin"))
        {
            <a asp-controller="ClinicPrices" asp-action="Index" class="btn btn-outline-primary">أسعار العيادات</a>
        }
        <a asp-action="Create" class="btn btn-primary">عيادة جديدة</a>
    </div>
</div>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
<table id="table1" class="table table-striped table-bordered w-100">
    <thead><tr><th>الاسم</th><th>العنوان</th><th>الهاتف</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td><a asp-action="Edit" asp-route-id="@c.Id">@c.Name</a></td>
            <td>@c.Address</td>
            <td>@c.Phone</td>
            <td class="text-nowrap">
                @if (User.IsInRole("Prog") || User.IsInRole("Admin"))
                {
                    <a asp-controller="ClinicPrices" asp-action="Manage" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">الأسعار</a>
                }
                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('حذف هذه العيادة؟');">
                    <button class="btn btn-sm btn-outline-danger">حذف</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
@section Scripts { <partial name="Partial/_datatables-js" /> }
