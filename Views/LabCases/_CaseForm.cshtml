@model LabCaseFormVM
@{
    var services = ViewBag.ServiceList as List<ServiceType> ?? [];
    var statusHelp = ViewBag.StatusHelp as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div asp-validation-summary="All" class="text-danger mb-2"></div>
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="Year" />
<input type="hidden" asp-for="Month" />

@if (Model.IsInvoiced)
{
    <div class="alert alert-warning">
        هذه الحالة مُفوترة في الفاتورة رقم <strong>@Model.InvoiceNumber</strong>.
        تعديل الأسطر الآن لن يغيّر الفاتورة الصادرة — ألغِ الفاتورة وأصدرها من جديد إن أردت تحديثها.
    </div>
}

<div class="card mb-3">
    <div class="card-body row g-3">
        <div class="col-md-2">
            <label asp-for="CaseNumber" class="form-label"></label>
            <input asp-for="CaseNumber" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="PatientName" class="form-label"></label>
            <input asp-for="PatientName" class="form-control" autocomplete="off"
                   data-suggest-url="@Url.Action("PatientNames", "LabCases")" />
            <span asp-validation-for="PatientName" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="DoctorId" class="form-label"></label>
            <select asp-for="DoctorId" id="DoctorId" class="form-select" asp-items="ViewBag.Doctors">
                <option value="">— اختر الطبيب —</option>
            </select>
            <span asp-validation-for="DoctorId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="ClinicId" class="form-label"></label>
            <select asp-for="ClinicId" id="ClinicId" class="form-select" asp-items="ViewBag.Clinics">
                <option value="">— اختر العيادة —</option>
            </select>
            <span asp-validation-for="ClinicId" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="ReceivedDate" class="form-label"></label>
            <input asp-for="ReceivedDate" class="form-control" />
            <div class="form-text">الشهر والسنة يُستنتجان من تاريخ الاستلام تلقائياً.</div>
        </div>
        <div class="col-md-3">
            <label asp-for="DeliveryDate" class="form-label"></label>
            <input asp-for="DeliveryDate" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" id="CaseStatus" class="form-select" asp-items="ViewBag.Statuses"></select>
            <div class="form-text" id="statusHelp">@(statusHelp.GetValueOrDefault(Model.Status ?? CaseStatus.Normal))</div>
        </div>
        <div class="col-md-3">
            <label asp-for="Notes" class="form-label"></label>
            <input asp-for="Notes" class="form-control" />
        </div>

        <div class="col-12" id="clinicCreditPanel" style="display:none;">
            <div class="border rounded p-3 bg-light">
                @if (Model.HasClinicCredit)
                {
                    <div class="alert alert-success mb-2 py-2">
                        تم تسجيل رصيد دائن لهذه الحالة بمبلغ <strong>@Model.ExistingClinicCreditAmount.ToString("N2")</strong>.
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-2 py-2 small">
                        إذا دفعت العيادة مسبقاً ثم ألغت الطلب، فعّل الخيار أدناه لتحويل المبلغ إلى رصيد دائن يُخصم من ذممها لاحقاً.
                        إن كان التحصيل مسجّلاً مسبقاً في الإيرادات لنفس المبلغ، لا تفعّل الخيار حتى لا يتضاعف الخصم.
                    </div>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <div class="form-check">
                                <input asp-for="CreateClinicCredit" class="form-check-input" id="createClinicCredit" />
                                <label asp-for="CreateClinicCredit" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-md-4" id="clinicCreditAmountWrap">
                            <label asp-for="ClinicCreditAmount" class="form-label"></label>
                            <input asp-for="ClinicCreditAmount" type="number" inputmode="decimal" step="0.01" min="0.01"
                                   class="form-control js-money" id="clinicCreditAmount"
                                   value="@(Model.ClinicCreditAmount ?? Model.Total)" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>أسطر الحالة (المنتجات)</strong>
        <div>
            <button type="button" class="btn btn-sm btn-outline-primary" id="addRow">+ سطر</button>
            <button type="button" class="btn btn-sm btn-outline-warning" id="addRemake">+ إعادة</button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered mb-0 align-middle" id="itemsTable">
            <thead>
                <tr>
                    <th style="min-width:190px">المنتج</th>
                    <th style="min-width:120px">وصف بديل</th>
                    <th style="width:150px">الأسنان</th>
                    <th style="width:80px">العدد</th>
                    <th style="width:100px">السعر</th>
                    <th style="width:100px">التكلفة</th>
                    <th style="width:170px">إعادة / السبب</th>
                    <th style="width:100px">الإجمالي</th>
                    <th style="width:50px"></th>
                </tr>
            </thead>
            <tbody id="itemsBody">
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    var item = Model.Items[i];
                    <tr class="item-row">
                        <td>
                            <input type="hidden" name="Items.Index" value="@i" />
                            <select name="Items[@i].ServiceTypeId" class="form-select js-service">
                                <option value="">— اختر المنتج —</option>
                                @foreach (var s in services)
                                {
                                    if (item.ServiceTypeId == s.Id)
                                    {
                                        <option value="@s.Id" data-per-tooth="@(s.PricedPerTooth ? "1" : "0")" selected>@s.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@s.Id" data-per-tooth="@(s.PricedPerTooth ? "1" : "0")">@s.Name</option>
                                    }
                                }
                            </select>
                        </td>
                        <td><input name="Items[@i].ProductName" value="@item.ProductName" class="form-control" placeholder="اختياري" /></td>
                        <td>
                            <input type="hidden" name="Items[@i].Teeth" value="@item.Teeth" class="js-teeth" />
                            <input type="hidden" name="Items[@i].OriginalUnitPrice" value="@item.OriginalUnitPrice" />
                            <input type="hidden" name="Items[@i].IsManualPrice" value="@(item.IsManualPrice ? "true" : "false")" />
                            <input type="hidden" name="Items[@i].ToothPosition" value="@(string.IsNullOrWhiteSpace(item.Teeth) ? item.ToothPosition : null)" class="js-teeth-legacy" />
                            <button type="button" class="teeth-open-btn js-teeth-open" title="اختيار الأسنان"></button>
                            @if (string.IsNullOrWhiteSpace(item.Teeth) && !string.IsNullOrWhiteSpace(item.ToothPosition))
                            {
                                <div class="small text-muted mt-1 js-teeth-legacy-note">سابقاً: @item.ToothPosition</div>
                            }
                        </td>
                        <td><input name="Items[@i].Quantity" value="@(item.Quantity < 1 ? 1 : item.Quantity)" type="number" min="1" class="form-control js-qty" /></td>
                        <td><input name="Items[@i].UnitPrice" value="@item.UnitPrice" type="number" step="0.01" min="0" class="form-control js-price" /></td>
                        <td><input name="Items[@i].UnitCost" value="@item.UnitCost" type="number" step="0.01" min="0" class="form-control js-cost" /></td>
                        <td>
                            <div class="form-check mb-1">
                                @if (item.IsRemake)
                                {
                                    <input type="checkbox" name="Items[@i].IsRemake" value="true" class="form-check-input js-remake" checked id="remake_@i" />
                                }
                                else
                                {
                                    <input type="checkbox" name="Items[@i].IsRemake" value="true" class="form-check-input js-remake" id="remake_@i" />
                                }
                                <input type="hidden" name="Items[@i].IsRemake" value="false" />
                                <label class="form-check-label" for="remake_@i">إعادة</label>
                            </div>
                            <div class="form-check mb-1 js-free-wrap" style="@(item.IsRemake ? "" : "display:none")">
                                <input type="checkbox" class="form-check-input js-free" id="free_@i" @(item.IsRemake && item.UnitPrice == 0 ? "checked" : "") />
                                <label class="form-check-label" for="free_@i">مجانية</label>
                            </div>
                            <select name="Items[@i].RemakeReason" class="form-select form-select-sm js-reason" @(item.IsRemake ? null : "disabled")>
                                <option value="">— السبب —</option>
                                @foreach (var r in RemakeReason.All)
                                {
                                    if (item.RemakeReason == r)
                                    {
                                        <option value="@r" selected>@r</option>
                                    }
                                    else
                                    {
                                        <option value="@r">@r</option>
                                    }
                                }
                            </select>
                        </td>
                        <td class="text-end"><span class="js-total">@item.LineTotal.ToString("N2")</span></td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger js-remove" title="حذف السطر">×</button></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <th colspan="3" class="text-end">الإجمالي</th>
                    <th><span id="sumQty">0</span></th>
                    <th colspan="3"></th>
                    <th class="text-end"><span id="sumTotal">0.00</span></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="card-footer small text-muted">
        السعر يُجلب تلقائياً: سعر الطبيب إن وُجد، وإلا سعر العيادة، وإلا السعر العام. ويمكنك تعديله لهذا السطر فقط.
        <br />
        الأسنان: اضغط على صليب الأسنان في السطر لاختيارها (مع الجسور والأسنان اللبنية). المنتجات المسعّرة بالسن يُملأ عددها تلقائياً.
        <br />
        الإعادة: علامة «إعادة» لا تغيّر السعر. أنت تقرر: اختر «مجانية» لتكون بلا مقابل للطبيب، أو اترك السعر ليُحسب عليه.
        <br />
        لإعادة عمل سابق مع إبقاء قيمة العمل الأصلي: استخدم «+ إعادة» لإضافة سطر جديد بدل تعليم السطر الأصلي.
    </div>
</div>

<template id="rowTemplate">
    <tr class="item-row">
        <td>
            <input type="hidden" name="Items.Index" value="__i__" />
            <select name="Items[__i__].ServiceTypeId" class="form-select js-service">
                <option value="">— اختر المنتج —</option>
                @foreach (var s in services)
                {
                    <option value="@s.Id" data-per-tooth="@(s.PricedPerTooth ? "1" : "0")">@s.Name</option>
                }
            </select>
        </td>
        <td><input name="Items[__i__].ProductName" class="form-control" placeholder="اختياري" /></td>
        <td>
            <input type="hidden" name="Items[__i__].Teeth" class="js-teeth" />
            <button type="button" class="teeth-open-btn js-teeth-open" title="اختيار الأسنان"></button>
        </td>
        <td><input name="Items[__i__].Quantity" value="1" type="number" min="1" class="form-control js-qty" /></td>
        <td><input name="Items[__i__].UnitPrice" value="0" type="number" step="0.01" min="0" class="form-control js-price" /></td>
        <td><input name="Items[__i__].UnitCost" value="0" type="number" step="0.01" min="0" class="form-control js-cost" /></td>
        <td>
            <div class="form-check mb-1">
                <input type="checkbox" name="Items[__i__].IsRemake" value="true" class="form-check-input js-remake" />
                <input type="hidden" name="Items[__i__].IsRemake" value="false" />
                <label class="form-check-label">إعادة</label>
            </div>
            <div class="form-check mb-1 js-free-wrap" style="display:none">
                <input type="checkbox" class="form-check-input js-free" />
                <label class="form-check-label">مجانية</label>
            </div>
            <select name="Items[__i__].RemakeReason" class="form-select form-select-sm js-reason" disabled>
                <option value="">— السبب —</option>
                @foreach (var r in RemakeReason.All)
                {
                    <option value="@r">@r</option>
                }
            </select>
        </td>
        <td class="text-end"><span class="js-total">0.00</span></td>
        <td><button type="button" class="btn btn-sm btn-outline-danger js-remove" title="حذف السطر">×</button></td>
    </tr>
</template>


<div class="modal fade" id="toothPickerModal" tabindex="-1" aria-labelledby="toothPickerTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="toothPickerTitle">اختيار الأسنان</h5>
                <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <div class="btn-group tp-dentition" role="group" aria-label="نوع الأسنان">
                        <button type="button" class="btn btn-outline-primary" data-d="permanent">أسنان دائمة (1–8)</button>
                        <button type="button" class="btn btn-outline-primary" data-d="primary">أسنان لبنية (A–E)</button>
                    </div>
                    <div>
                        <button type="button" class="btn btn-outline-success tp-bridge-start">+ جسر جديد</button>
                        <span class="tp-bridge-bar" style="display:none">
                            <span class="small text-muted ms-2">اضغط على أسنان الجسر المتجاورة ثم:</span>
                            <button type="button" class="btn btn-success tp-bridge-done">إنهاء الجسر</button>
                            <button type="button" class="btn btn-outline-secondary tp-bridge-cancel">إلغاء الجسر</button>
                        </span>
                    </div>
                </div>

                <div class="d-flex justify-content-between small text-muted mb-1" dir="ltr"><span>يمين المريض</span><span>يسار المريض</span></div>
                <div class="tp-chart border rounded p-2 mb-2">
                    <div class="tp-q tp-q1"></div><div class="tp-q tp-q2"></div>
                    <div class="tp-q tp-q4"></div><div class="tp-q tp-q3"></div>
                </div>
                <div class="small text-muted tp-legend mb-2">
                    <span style="background:#0d6efd"></span>سن مفرد
                    <span style="background:#198754"></span>دعامة جسر
                    <span style="border:2px dashed #198754"></span>دمية (اضغط على سن داخل الجسر للتبديل)
                    <span style="background:#fff3cd;border:2px solid #fd7e14"></span>جسر قيد الاختيار
                </div>
                <div class="alert alert-danger py-2 tp-error" style="display:none"></div>

                <div class="d-flex flex-wrap align-items-center gap-3 border-top pt-2">
                    <div class="tp-preview fs-5"></div>
                    <div>
                        <div class="tp-summary fw-bold"></div>
                        <div class="tp-list"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-danger tp-clear">مسح الكل</button>
                <div>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="button" class="btn btn-primary tp-save">حفظ الأسنان</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="statusHelpJson">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusHelp))
</script>
