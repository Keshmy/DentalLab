@model LabCase
@{
    ViewData["Title"] = "تفاصيل الحالة";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">الحالة @Model.CaseNumber — @Model.PatientName</h4>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">تعديل</a>
        @if (User.IsInRole("Prog") || User.IsInRole("Admin"))
        {
            <a asp-controller="AuditLogs" asp-action="Index" asp-route-entityId="@Model.Id" class="btn btn-outline-info">سجل التغييرات</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row g-3">
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header"><strong>بيانات الحالة</strong></div>
            <table class="table mb-0">
                <tr><th>الطبيب</th><td>@Model.Doctor?.Name</td></tr>
                <tr><th>المركز / العيادة</th><td>@Model.Clinic?.Name</td></tr>
                <tr><th>تاريخ الاستلام</th><td>@Model.ReceivedDate?.ToString("yyyy/M/d")</td></tr>
                <tr><th>موعد التسليم</th><td>@(Model.DeliveryDate?.ToString("yyyy/M/d") ?? "—")</td></tr>
                <tr>
                    <th>التسليم الفعلي</th>
                    <td>
                        <form asp-action="MarkDelivered" method="post" class="d-flex align-items-center gap-2">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="returnTo" value="details" />
                            @if (Model.IsDelivered)
                            {
                                <span class="badge bg-success">سُلِّمت @Model.DeliveredAt?.ToString("yyyy/M/d HH:mm")</span>
                                <input type="hidden" name="delivered" value="false" />
                                <button class="btn btn-sm btn-outline-secondary">تراجع</button>
                            }
                            else if (Model.Status != CaseStatus.Cancelled)
                            {
                                <span class="badge @(Model.DeliveryDate?.Date < DateTime.Today ? "bg-danger" : "bg-warning text-dark")">لم تُسلَّم</span>
                                <input type="hidden" name="delivered" value="true" />
                                <button class="btn btn-sm btn-success">تم التسليم</button>
                            }
                        </form>
                    </td>
                </tr>
                <tr><th>الشهر / السنة</th><td>@Model.Month / @Model.Year</td></tr>
                <tr>
                    <th>الحالة</th>
                    <td>
                        @Model.Status
                        <div class="small text-muted">@CaseStatus.Describe(Model.Status)</div>
                    </td>
                </tr>
                <tr>
                    <th>الفاتورة</th>
                    <td>
                        @if (Model.Invoice != null)
                        {
                            <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.Invoice.Id">
                                فاتورة رقم @Model.Invoice.Number
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">لم تُفوتر بعد</span>
                        }
                    </td>
                </tr>
                <tr><th>ملاحظات</th><td>@Model.Notes</td></tr>
            </table>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header"><strong>الأسطر</strong></div>
            <div class="table-responsive">
                <table class="table table-bordered mb-0">
                    <thead>
                        <tr>
                            <th>المنتج</th>
                            <th>مكان الأسنان</th>
                            <th>العدد</th>
                            <th>السعر</th>
                            <th>الإجمالي</th>
                            <th>التكلفة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items.OrderBy(i => i.IsRemake).ThenBy(i => i.Created))
                        {
                            <tr class="@(item.IsRemake ? "table-warning" : "")">
                                <td>
                                    @item.DisplayName
                                    @if (item.IsRemake)
                                    {
                                        <span class="badge bg-warning text-dark">إعادة @item.RemakeSequence</span>
                                        @if (!string.IsNullOrWhiteSpace(item.RemakeReason))
                                        {
                                            <small class="d-block text-muted">@item.RemakeReason</small>
                                        }
                                        @if (item.UnitPrice == 0)
                                        {
                                            <small class="d-block text-danger">على حساب المعمل</small>
                                        }
                                    }
                                </td>
                                <td>@(item.ToothPosition ?? "—")</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("N2")</td>
                                <td>@item.LineTotal.ToString("N2")</td>
                                <td class="text-muted">@((item.Quantity * item.UnitCost).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <th colspan="2">الإجمالي</th>
                            <th>@Model.Units</th>
                            <th></th>
                            <th>@Model.Total.ToString("N2")</th>
                            <th>@Model.Items.Sum(i => i.Quantity * i.UnitCost).ToString("N2")</th>
                        </tr>
                        <tr>
                            <th colspan="4" class="text-end">الربح الإجمالي للحالة</th>
                            <th colspan="2">
                                @((Model.Total - Model.Items.Sum(i => i.Quantity * i.UnitCost)).ToString("N2"))
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@if (!Model.IsInvoiced)
{
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3"
          onsubmit="return confirm('حذف الحالة وكل أسطرها؟');">
        <button class="btn btn-outline-danger">حذف الحالة</button>
    </form>
}
