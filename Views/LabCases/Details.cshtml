@model LabCase
@{
    ViewData["Title"] = "تفاصيل الحالة";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">الحالة @Model.CaseNumber — @Model.PatientName</h4>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">تعديل</a>
        <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header"><strong>بيانات الحالة</strong></div>
            <table class="table mb-0">
                <tr><th>الطبيب</th><td>@Model.Doctor?.Name</td></tr>
                <tr><th>المركز / العيادة</th><td>@Model.Clinic?.Name</td></tr>
                <tr><th>تاريخ الاستلام</th><td>@Model.ReceivedDate?.ToString("yyyy/M/d")</td></tr>
                <tr><th>تاريخ التسليم</th><td>@(Model.DeliveryDate?.ToString("yyyy/M/d") ?? "لم يُسلَّم")</td></tr>
                <tr><th>مكان الأسنان</th><td>@Model.ToothPosition</td></tr>
                <tr><th>الشهر / السنة</th><td>@Model.Month / @Model.Year</td></tr>
                <tr><th>رقم المستند</th><td>@Model.DocumentNumber</td></tr>
                <tr><th>إيصال قبض</th><td>@Model.ReceiptNumber</td></tr>
                <tr><th>الحالة</th><td>@Model.Status</td></tr>
                <tr>
                    <th>الفاتورة</th>
                    <td>
                        @if (Model.Invoice != null)
                        {
                            <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.Invoice.Id">
                                فاتورة رقم @Model.Invoice.Number
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">لم تُفوتر بعد</span>
                        }
                    </td>
                </tr>
                <tr><th>ملاحظات</th><td>@Model.Notes</td></tr>
            </table>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header"><strong>الأسطر</strong></div>
            <div class="table-responsive">
                <table class="table table-bordered mb-0">
                    <thead>
                        <tr>
                            <th>المنتج</th>
                            <th>العدد</th>
                            <th>السعر</th>
                            <th>الإجمالي</th>
                            <th>التكلفة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items.OrderBy(i => i.IsRemake).ThenBy(i => i.Created))
                        {
                            <tr class="@(item.IsRemake ? "table-warning" : "")">
                                <td>
                                    @item.DisplayName
                                    @if (item.IsRemake)
                                    {
                                        <span class="badge bg-warning text-dark">إعادة @item.RemakeSequence</span>
                                        @if (!string.IsNullOrWhiteSpace(item.RemakeReason))
                                        {
                                            <small class="d-block text-muted">@item.RemakeReason</small>
                                        }
                                        @if (item.UnitPrice == 0)
                                        {
                                            <small class="d-block text-danger">على حساب المعمل</small>
                                        }
                                    }
                                </td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("N2")</td>
                                <td>@item.LineTotal.ToString("N2")</td>
                                <td class="text-muted">@((item.Quantity * item.UnitCost).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <th>الإجمالي</th>
                            <th>@Model.Units</th>
                            <th></th>
                            <th>@Model.Total.ToString("N2")</th>
                            <th>@Model.Items.Sum(i => i.Quantity * i.UnitCost).ToString("N2")</th>
                        </tr>
                        <tr>
                            <th colspan="3" class="text-end">الربح الإجمالي للحالة</th>
                            <th colspan="2">
                                @((Model.Total - Model.Items.Sum(i => i.Quantity * i.UnitCost)).ToString("N2"))
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@if (!Model.IsInvoiced)
{
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3"
          onsubmit="return confirm('حذف الحالة وكل أسطرها؟');">
        <button class="btn btn-outline-danger">حذف الحالة</button>
    </form>
}
