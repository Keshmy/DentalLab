@model IEnumerable<LabCase>
@{
    ViewData["Title"] = "الحالات";
}
<partial name="Partial/_datatables-css" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold">الحالات</h3>
    <a asp-action="Create" class="btn btn-primary">حالة جديدة</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <input name="year" class="form-control" placeholder="السنة" value="@ViewBag.Year" />
    </div>
    <div class="col-md-2">
        <select name="month" class="form-select">
            <option value="">كل الأشهر</option>
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@((int?)ViewBag.Month == m)">شهر @m</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="doctorId" class="form-select" asp-items="ViewBag.Doctors">
            <option value="">كل الأطباء</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="clinicId" class="form-select" asp-items="ViewBag.Clinics">
            <option value="">كل المراكز</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select" asp-items="ViewBag.Statuses">
            <option value="">كل الحالات</option>
        </select>
    </div>
    <div class="col-md-2">
        <input name="search" class="form-control" placeholder="بحث بالاسم أو المنتج" value="@ViewBag.Search" />
    </div>
    <div class="col-12">
        <button class="btn btn-outline-primary">تصفية</button>
        <a asp-action="Index" class="btn btn-outline-secondary">إعادة</a>
    </div>
</form>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">عدد الحالات</div>
            <div class="fs-5 fw-bold">@Model.Count()</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">عدد الوحدات</div>
            <div class="fs-5 fw-bold">@Model.Sum(c => c.Units)</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">الإجمالي</div>
            <div class="fs-5 fw-bold">@Model.Where(c => c.IsBillable).Sum(c => c.Total).ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">إعادات</div>
            <div class="fs-5 fw-bold">@Model.Sum(c => c.RemakeCount)</div>
        </div></div>
    </div>
</div>

<table id="table1" class="table table-striped table-bordered table-hover w-100">
    <thead>
        <tr>
            <th>رقم</th>
            <th>الاسم</th>
            <th>الطبيب</th>
            <th>المركز</th>
            <th>المنتجات</th>
            <th>الوحدات</th>
            <th>التاريخ</th>
            <th>الإجمالي</th>
            <th>الحالة</th>
            <th>الفاتورة</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CaseNumber</td>
                <td><a asp-action="Edit" asp-route-id="@item.Id">@item.PatientName</a></td>
                <td>@item.Doctor?.Name</td>
                <td>@item.Clinic?.Name</td>
                <td>
                    @string.Join(" + ", item.Items.Select(i => i.DisplayName))
                    @if (item.RemakeCount > 0)
                    {
                        <span class="badge bg-warning text-dark">إعادة @item.RemakeCount</span>
                    }
                </td>
                <td>@item.Units</td>
                <td>@item.ReceivedDate?.ToString("yyyy/M/d")</td>
                <td data-order="@item.Total">@item.Total.ToString("N2")</td>
                <td>@item.Status</td>
                <td>
                    @if (item.IsInvoiced)
                    {
                        <span class="badge bg-success">مُفوترة</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">لم تُفوتر</span>
                    }
                </td>
                <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">عرض</a></td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="Partial/_datatables-js" />
}
