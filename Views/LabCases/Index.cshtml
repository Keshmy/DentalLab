@model IEnumerable<LabCase>
@{
    ViewData["Title"] = "الحالات";
}
<partial name="Partial/_datatables-css" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold">الحالات</h3>
    <div class="d-flex gap-2">
        <a asp-action="Due" class="btn btn-outline-warning">مواعيد التسليم</a>
        <partial name="Partial/_exportButtons" model="@("Export")" />
        <a asp-action="Create" class="btn btn-primary">حالة جديدة</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <input name="year" class="form-control" placeholder="السنة" value="@ViewBag.Year" />
    </div>
    <div class="col-md-2">
        <select name="month" class="form-select">
            <option value="">كل الأشهر</option>
            @for (int m = 1; m <= 12; m++)
            {
                if ((int?)ViewBag.Month == m)
                {
                    <option value="@m" selected>شهر @m</option>
                }
                else
                {
                    <option value="@m">شهر @m</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="doctorId" class="form-select" asp-items="ViewBag.Doctors">
            <option value="">كل الأطباء</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="clinicId" class="form-select" asp-items="ViewBag.Clinics">
            <option value="">كل المراكز</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select" asp-items="ViewBag.Statuses">
            <option value="">كل الحالات</option>
        </select>
    </div>
    <div class="col-md-2">
        <input name="search" class="form-control" placeholder="بحث بالاسم أو المنتج" value="@ViewBag.Search" />
    </div>
    <div class="col-12">
        <button class="btn btn-outline-primary">تصفية</button>
        <a asp-action="Index" class="btn btn-outline-secondary">إعادة</a>
    </div>
</form>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">عدد الحالات</div>
            <div class="fs-5 fw-bold">@Model.Count()</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">عدد الوحدات</div>
            <div class="fs-5 fw-bold">@Model.Sum(c => c.Units)</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">الإجمالي</div>
            <div class="fs-5 fw-bold">@Model.Where(c => c.IsBillable).Sum(c => c.Total).ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">إعادات</div>
            <div class="fs-5 fw-bold">@Model.Sum(c => c.RemakeCount)</div>
        </div></div>
    </div>
</div>

<div class="d-flex justify-content-end mb-2">
    <div class="dropdown">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="colToggleBtn"
                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
            <i class="bi bi-layout-three-columns"></i> الأعمدة
        </button>
        <div class="dropdown-menu dropdown-menu-end p-2" aria-labelledby="colToggleBtn" id="colToggleMenu" style="min-width:200px"></div>
    </div>
</div>

<table id="table1" class="table table-striped table-bordered table-hover w-100">
    <thead>
        <tr>
            <th>رقم</th>
            <th>الاسم</th>
            <th>الطبيب</th>
            <th>المركز</th>
            <th>المنتجات</th>
            <th>الوحدات</th>
            <th>التاريخ</th>
            <th>التسليم</th>
            <th>الملاحظات</th>
            <th>الإجمالي</th>
            <th>الحالة</th>
            <th>الفاتورة</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CaseNumber</td>
                <td><a asp-action="Edit" asp-route-id="@item.Id">@item.PatientName</a></td>
                <td>@item.Doctor?.Name</td>
                <td>@item.Clinic?.Name</td>
                <td>
                    @string.Join(" + ", item.Items.Select(i => i.DisplayName))
                    @if (item.RemakeCount > 0)
                    {
                        <span class="badge bg-warning text-dark">إعادة @item.RemakeCount</span>
                    }
                </td>
                <td>@item.Units</td>
                <td data-order="@item.ReceivedDate?.ToString("yyyyMMdd")">@item.ReceivedDate?.ToString("yyyy/M/d")</td>
                <td data-order="@item.DeliveryDate?.ToString("yyyyMMdd")">@item.DeliveryDate?.ToString("yyyy/M/d")</td>
                <td class="small text-wrap" style="max-width:240px;white-space:pre-line">@item.Notes</td>
                <td data-order="@item.Total">@item.Total.ToString("N2")</td>
                <td>@item.Status</td>
                <td>
                    @if (item.IsInvoiced)
                    {
                        <span class="badge bg-success">مُفوترة</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">لم تُفوتر</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">عرض</a>
                    @if (!item.IsInvoiced)
                    {
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                              onsubmit="return confirm('حذف الحالة وكل أسطرها؟');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="Partial/_datatables-js" />
    <script>
        // إظهار/إخفاء أعمدة جدول الحالات — الاختيار يُحفظ في هذا المتصفح.
        $(function () {
            var table = $('#table1').DataTable();
            // التهيئة تنتظر ملف اللغة، فننتظرها قبل لمس الأعمدة
            table.ready(function () { initColumnToggles(table); });
        });

        function initColumnToggles(table) {
            var key = 'labcases.hiddenColumns.v1';
            var defaultsHidden = [7];            // التسليم مخفي افتراضياً
            var lastCol = table.columns().count() - 1;   // عمود الأزرار يبقى دائماً
            var hidden;
            try { hidden = JSON.parse(localStorage.getItem(key)); } catch (e) { hidden = null; }
            if (!Array.isArray(hidden)) hidden = defaultsHidden;

            var menu = $('#colToggleMenu');
            table.columns().every(function (i) {
                if (i === lastCol) return;
                var title = $(this.header()).text().trim();
                var visible = hidden.indexOf(i) === -1;
                this.visible(visible, false);
                // label بسيط بدل form-check: تنسيق القالب لـ form-check يُركّب المربع فوق النص
                menu.append(
                    $('<label class="dropdown-item d-flex align-items-center gap-2 py-1 m-0" style="cursor:pointer">').append(
                        $('<input type="checkbox">').val(i).prop('checked', visible),
                        $('<span>').text(title)));
            });
            table.columns.adjust().draw(false);

            menu.on('change', 'input', function () {
                var i = +this.value;
                table.column(i).visible(this.checked);
                hidden = menu.find('input:not(:checked)').map(function () { return +this.value; }).get();
                try { localStorage.setItem(key, JSON.stringify(hidden)); } catch (e) { }
            });
        }
    </script>
}
