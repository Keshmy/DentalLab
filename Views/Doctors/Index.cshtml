@model IEnumerable<Doctor>
@{ ViewData["Title"] = "الأطباء"; }
<partial name="Partial/_datatables-css" />
<div class="d-flex justify-content-between mb-3">
    <h3>الأطباء</h3>
    <a asp-action="Create" class="btn btn-primary">طبيب جديد</a>
</div>
<table id="table1" class="table table-striped table-bordered w-100">
    <thead><tr><th>الاسم</th><th>الهاتف</th><th>ملاحظات</th><th></th></tr></thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td><a asp-action="Edit" asp-route-id="@d.Id">@d.Name</a></td>
            <td>@d.Phone</td>
            <td>@d.Notes</td>
            <td>
                <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline" onsubmit="return confirm('حذف؟');">
                    <button class="btn btn-sm btn-outline-danger">حذف</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
@section Scripts { <partial name="Partial/_datatables-js" /> }
