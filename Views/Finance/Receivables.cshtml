@model List<DentalLab.ViewModels.Finance.ClinicReceivableVM>
@{
    ViewData["Title"] = "ذمم المراكز";
}
<partial name="Partial/_datatables-css" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">ذمم المراكز</h3>
    <a asp-action="Index" class="btn btn-outline-secondary">الأرباح والخسائر</a>
</div>

<div class="alert alert-light border">
    المتبقي على كل مركز = <strong>رصيد افتتاحي + إجمالي أعماله − ما حُصِّل منه</strong>.
    إجمالي الأعمال يُحسب من أسطر الحالات مباشرة، والتحصيل من سجل الإيرادات المُستلمة.
</div>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">إجمالي الأعمال</div>
            <div class="fs-5 fw-bold">@Model.Sum(x => x.Invoiced).ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">المحصَّل</div>
            <div class="fs-5 fw-bold text-success">@Model.Sum(x => x.Collected).ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">المتبقي (ديون)</div>
            <div class="fs-5 fw-bold text-danger">@Model.Sum(x => x.Balance).ToString("N2")</div>
        </div></div>
    </div>
</div>

<table id="table1" class="table table-striped table-bordered w-100">
    <thead>
        <tr>
            <th>المركز</th>
            <th>الحالات</th>
            <th>الوحدات</th>
            <th>رصيد افتتاحي</th>
            <th>إجمالي الأعمال</th>
            <th>المحصَّل</th>
            <th>المتبقي</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.ClinicName</td>
                <td>@r.CaseCount</td>
                <td>@r.Units</td>
                <td>@r.OpeningBalance.ToString("N2")</td>
                <td>@r.Invoiced.ToString("N2")</td>
                <td class="text-success">@r.Collected.ToString("N2")</td>
                <td class="fw-bold @(r.Balance > 0 ? "text-danger" : r.Balance < 0 ? "text-primary" : "")">
                    @r.Balance.ToString("N2")
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="table-light fw-bold">
            <th colspan="4" class="text-end">الإجمالي</th>
            <th>@Model.Sum(x => x.Invoiced).ToString("N2")</th>
            <th>@Model.Sum(x => x.Collected).ToString("N2")</th>
            <th>@Model.Sum(x => x.Balance).ToString("N2")</th>
        </tr>
    </tfoot>
</table>

@section Scripts { <partial name="Partial/_datatables-js" /> }
