@model DentalLab.ViewModels.Finance.RemakeReportVM
@{
    ViewData["Title"] = "تقرير الإعادات";
    var monthNames = new[] { "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
}
<partial name="Partial/_datatables-css" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">الإعادات لكل طبيب</h3>
    <a asp-action="Index" class="btn btn-outline-secondary">الأرباح والخسائر</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <select name="year" class="form-select">
            @foreach (var y in Model.AvailableYears)
            {
                <option value="@y" selected="@(y == Model.Year)">@y</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="month" class="form-select">
            <option value="">كل السنة</option>
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(Model.Month == m)">@monthNames[m - 1]</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-primary w-100">عرض</button>
    </div>
</form>

<div class="alert alert-light border">
    الإعادة تُسجَّل سطراً على نفس الحالة وتبقى مرتبطة بالطبيب.
    <strong>الإعادة بسعر صفر</strong> على حساب المعمل: خسارتها = تكلفة المواد المهدرة + الإيراد الذي كان ممكناً.
    <strong>الإعادة بسعر</strong> تُحاسَب على الطبيب وتدخل الإيراد.
</div>

<div class="row g-2 mb-4">
    <div class="col-md-3">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">وحدات الإعادة</div>
            <div class="fs-5 fw-bold">@Model.RemakeUnits <small class="text-muted">من @Model.TotalUnits (@Model.RemakeRatio%)</small></div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">إيراد الإعادات المحاسَبة</div>
            <div class="fs-5 fw-bold text-success">@Model.ChargedAmount.ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">تكلفة مواد مهدرة</div>
            <div class="fs-5 fw-bold text-danger">@Model.FreeCost.ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card"><div class="card-body py-2">
            <div class="small text-muted">صافي أثر الإعادات</div>
            <div class="fs-5 fw-bold @(Model.NetImpact >= 0 ? "text-success" : "text-danger")">@Model.NetImpact.ToString("N2")</div>
            <small class="text-muted">إيراد ضائع @Model.LostRevenue.ToString("N2")</small>
        </div></div>
    </div>
</div>

@if (Model.ByReason.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header"><strong>الأسباب</strong></div>
        <div class="card-body d-flex flex-wrap gap-2">
            @foreach (var r in Model.ByReason)
            {
                <span class="badge bg-secondary fs-6">@r.Key: @r.Value وحدة</span>
            }
        </div>
    </div>
}

<table id="table1" class="table table-striped table-bordered w-100">
    <thead>
        <tr>
            <th>الطبيب</th>
            <th>إجمالي الوحدات</th>
            <th>وحدات الإعادة</th>
            <th>النسبة</th>
            <th>محاسَبة</th>
            <th>مجانية</th>
            <th>إيراد الإعادات</th>
            <th>مواد مهدرة</th>
            <th>إيراد ضائع</th>
            <th>صافي الأثر</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.DoctorName</td>
                <td>@r.TotalUnits</td>
                <td>@r.RemakeUnits</td>
                <td class="@(r.RemakeRatio > 10 ? "text-danger fw-bold" : "")">@r.RemakeRatio%</td>
                <td>@r.ChargedUnits</td>
                <td>@r.FreeUnits</td>
                <td class="text-success">@r.ChargedAmount.ToString("N2")</td>
                <td class="text-danger">@r.FreeCost.ToString("N2")</td>
                <td class="text-warning">@r.LostRevenue.ToString("N2")</td>
                <td class="fw-bold @(r.NetImpact >= 0 ? "text-success" : "text-danger")">@r.NetImpact.ToString("N2")</td>
            </tr>
        }
        @if (Model.Rows.Count == 0)
        {
            <tr><td colspan="10" class="text-muted">لا توجد إعادات في هذه الفترة</td></tr>
        }
    </tbody>
</table>

@section Scripts { <partial name="Partial/_datatables-js" /> }
