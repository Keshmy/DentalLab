@model DentalLab.ViewModels.Finance.FinanceSummaryVM
@{
    ViewData["Title"] = "الأرباح والخسائر";
    var monthNames = new[] { "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    var period = Model.Month.HasValue ? $"{monthNames[Model.Month.Value - 1]} {Model.Year}" : $"سنة {Model.Year}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">الأرباح والخسائر — @period</h3>
    <div>
        <a asp-action="Receivables" class="btn btn-outline-primary">الذمم</a>
        <a asp-action="Remakes" asp-route-year="@Model.Year" class="btn btn-outline-warning">الإعادات</a>
        <a asp-controller="Ledger" asp-action="Index" class="btn btn-outline-secondary">سجل الصندوق</a>
    </div>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3">
        <select name="year" class="form-select">
            @foreach (var y in Model.AvailableYears)
            {
                <option value="@y" selected="@(y == Model.Year)">@y</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="month" class="form-select">
            <option value="">كل السنة</option>
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(Model.Month == m)">@monthNames[m - 1]</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-primary w-100">عرض</button>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-light">
                <strong>قائمة الأرباح (بالاستحقاق)</strong>
                <small class="text-muted d-block">الربح الحقيقي — يحسب العمل المنفَّذ سواء تم تحصيله أم لا</small>
            </div>
            <table class="table mb-0">
                <tr>
                    <th>الإيراد المفوتر</th>
                    <td class="text-end fw-bold">@Model.Revenue.ToString("N2")</td>
                </tr>
                <tr>
                    <th class="ps-4 fw-normal text-muted">− المصروفات التشغيلية</th>
                    <td class="text-end text-danger">@Model.OperatingExpenses.ToString("N2")</td>
                </tr>
                <tr>
                    <th class="ps-4 fw-normal text-muted">− ديون معدومة (سلف مشطوبة)</th>
                    <td class="text-end text-danger">@Model.WrittenOffLoans.ToString("N2")</td>
                </tr>
                <tr class="table-light">
                    <th>= الربح قبل النسبة</th>
                    <td class="text-end fw-bold">@Model.AccrualProfit.ToString("N2")</td>
                </tr>
                <tr>
                    <th class="ps-4 fw-normal text-muted">
                        − نسبة @(Model.PartnerName ?? "الشريك") (@Model.PartnerSharePercent.ToString("N2")٪)
                    </th>
                    <td class="text-end text-danger">@Model.PartnerShare.ToString("N2")</td>
                </tr>
                <tr class="@(Model.NetProfit >= 0 ? "table-success" : "table-danger")">
                    <th class="fs-5">= صافي الربح</th>
                    <td class="text-end fs-5 fw-bold">@Model.NetProfit.ToString("N2")</td>
                </tr>
            </table>
            <div class="card-footer small text-muted">
                لا تدخل هنا: <strong>الأجهزة والمعدات</strong> (@Model.CapitalExpenses.ToString("N2")) لأنها أصول تُستهلك على سنوات،
                ولا <strong>السلف الممنوحة</strong> لأنها ذمة على الأشخاص لا مصروف.
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-light">
                <strong>الحركة النقدية</strong>
                <small class="text-muted d-block">ما دخل الصندوق وخرج منه فعلاً</small>
            </div>
            <table class="table mb-0">
                <tr>
                    <th>التحصيلات</th>
                    <td class="text-end text-success">@Model.Collections.ToString("N2")</td>
                </tr>
                <tr>
                    <th class="fw-normal text-muted">+ سداد سلف</th>
                    <td class="text-end text-success">@Model.LoansRepaid.ToString("N2")</td>
                </tr>
                @if (Model.LoansBorrowed != 0)
                {
                    <tr>
                        <th class="fw-normal text-muted">+ ديون علينا قبضناها</th>
                        <td class="text-end text-success">@Model.LoansBorrowed.ToString("N2")</td>
                    </tr>
                }
                <tr>
                    <th class="fw-normal text-muted">− المصروفات المدفوعة</th>
                    <td class="text-end text-danger">@Model.PaidExpenses.ToString("N2")</td>
                </tr>
                <tr>
                    <th class="fw-normal text-muted">− سلف ممنوحة</th>
                    <td class="text-end text-danger">@Model.LoansGiven.ToString("N2")</td>
                </tr>
                @if (Model.LoansSettled != 0)
                {
                    <tr>
                        <th class="fw-normal text-muted">− سداد ديون علينا</th>
                        <td class="text-end text-danger">@Model.LoansSettled.ToString("N2")</td>
                    </tr>
                }
                <tr class="@(Model.CashProfit >= 0 ? "table-success" : "table-danger")">
                    <th class="fs-5">= صافي النقد</th>
                    <td class="text-end fs-5 fw-bold">@Model.CashProfit.ToString("N2")</td>
                </tr>
            </table>
            <div class="card-header bg-light border-top">
                <strong>لماذا يختلف الربح عن النقد؟</strong>
            </div>
            <table class="table mb-0">
                <tr>
                    <th class="fw-normal">الفرق بين الربح والنقد</th>
                    <td class="text-end fw-bold">@Model.Bridge.ToString("N2")</td>
                </tr>
                <tr>
                    <th class="fw-normal text-muted">إيرادات مفوترة لم تُحصَّل</th>
                    <td class="text-end">@Model.PendingIncome.ToString("N2")</td>
                </tr>
                <tr>
                    <th class="fw-normal text-muted">سلف خرجت من الصندوق ولم تُسدَّد</th>
                    <td class="text-end">@((Model.LoansGiven - Model.LoansRepaid).ToString("N2"))</td>
                </tr>
                <tr>
                    <th class="fw-normal text-muted">أجهزة اشتُريت (أصول)</th>
                    <td class="text-end">@Model.CapitalExpenses.ToString("N2")</td>
                </tr>
                @if (Model.LoansBorrowed != 0 || Model.LoansSettled != 0)
                {
                    <tr>
                        <th class="fw-normal text-muted">ديون علينا (قبض ناقص سداد)</th>
                        <td class="text-end">@((Model.LoansBorrowed - Model.LoansSettled).ToString("N2"))</td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body py-2">
            <div class="small text-muted">عدد الوحدات</div>
            <div class="fs-5 fw-bold">@Model.Units</div>
            <small class="text-muted">
                متوسط سعر الوحدة
                @(Model.Units == 0 ? "0.00" : Math.Round(Model.Revenue / Model.Units, 2).ToString("N2"))
            </small>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body py-2">
            <div class="small text-muted">ربح الوحدات (إيراد − تكلفة مواد)</div>
            <div class="fs-5 fw-bold">@Model.GrossMargin.ToString("N2")</div>
            <small class="text-muted">تكلفة المواد @Model.MaterialCost.ToString("N2")</small>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body py-2">
            <div class="small text-muted">ذمم المراكز</div>
            <div class="fs-5 fw-bold text-danger">@Model.TotalReceivables.ToString("N2")</div>
            <small class="text-muted">مفوتر ولم يُحصَّل</small>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body py-2">
            <div class="small text-muted">سلف قائمة</div>
            <div class="fs-5 fw-bold">@Model.TotalLoanBalance.ToString("N2")</div>
            <small class="text-muted">خسارة إعادات مجانية @Model.FreeRemakeCost.ToString("N2")</small>
        </div></div>
    </div>
</div>

@if (Model.PartnerShareRecorded > 0 && Model.PartnerSharePercent > 0)
{
    <div class="alert alert-warning">
        نسبة الشريك المحسوبة من الربح هي <strong>@Model.PartnerShare.ToString("N2")</strong>،
        لكن هناك <strong>@Model.PartnerShareRecorded.ToString("N2")</strong> مُدخلة يدوياً كمصروف في بند «نسبة شريك».
        المُدخل يدوياً <em>غير</em> محسوب في المصروفات التشغيلية أعلاه حتى لا تُحتسب النسبة مرتين — قارن الرقمين وسوِّ الفرق.
    </div>
}

<div class="card">
    <div class="card-header"><strong>تفصيل الأشهر</strong></div>
    <div class="table-responsive">
        <table class="table table-striped table-bordered mb-0">
            <thead>
                <tr>
                    <th>الشهر</th>
                    <th>الوحدات</th>
                    <th>الإيراد</th>
                    <th>مصروفات</th>
                    <th>الربح قبل النسبة</th>
                    <th>النسبة</th>
                    <th>صافي الربح</th>
                    <th>محصَّل</th>
                    <th>لم يُحصَّل</th>
                    <th>صافي النقد</th>
                    <th>إعادات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Months)
                {
                    <tr>
                        <td>@m.MonthName</td>
                        <td>@m.Units</td>
                        <td>@m.Revenue.ToString("N2")</td>
                        <td class="text-danger">@m.OperatingExpenses.ToString("N2")</td>
                        <td>@m.AccrualProfit.ToString("N2")</td>
                        <td>@m.PartnerShare.ToString("N2")</td>
                        <td class="fw-bold @(m.NetProfit >= 0 ? "text-success" : "text-danger")">@m.NetProfit.ToString("N2")</td>
                        <td class="text-success">@m.Collections.ToString("N2")</td>
                        <td class="text-warning">@m.PendingIncome.ToString("N2")</td>
                        <td class="@(m.CashProfit >= 0 ? "" : "text-danger")">@m.CashProfit.ToString("N2")</td>
                        <td>
                            @m.RemakeUnits
                            @if (m.RemakeRatio > 0)
                            {
                                <small class="text-muted">(@m.RemakeRatio%)</small>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light fw-bold">
                    <th>الإجمالي</th>
                    <th>@Model.Units</th>
                    <th>@Model.Revenue.ToString("N2")</th>
                    <th>@Model.OperatingExpenses.ToString("N2")</th>
                    <th>@Model.AccrualProfit.ToString("N2")</th>
                    <th>@Model.PartnerShare.ToString("N2")</th>
                    <th>@Model.NetProfit.ToString("N2")</th>
                    <th>@Model.Collections.ToString("N2")</th>
                    <th>@Model.PendingIncome.ToString("N2")</th>
                    <th>@Model.CashProfit.ToString("N2")</th>
                    <th>@Model.RemakeUnits</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
