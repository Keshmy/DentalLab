@inject IUnitOfWork<SiteInfo> _siteInfo
@inject IUnitOfWork<UserProfile> _userProfile
@inject UserManager<ApplicationUser> _userManager
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta name="viewport" content="width=device-width" />
    <meta charset="utf-8" />
    @{
        var siteInfo = _siteInfo.Repository.GetAll().SingleOrDefault();
        ViewBag.SiteName = siteInfo?.Name ?? "مختبر حد السيف";
        ViewBag.LogoUrl = siteInfo?.LogoUrl;
    }
    <partial name="Partial/_title" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/assets1/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/assets1/css/style.css">
    <link href="~/css/template.css" rel="stylesheet" />
    <link href="~/css/dashboard.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <style>
        body, .navbar, .sidebar, .main-panel { font-family: 'Cairo', sans-serif !important; }
    </style>
</head>
<body class="rtl sidebar-fixed">
    <div class="container-scroller">
        <nav class="navbar default-layout-navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row border-bottom">
            <div class="navbar-menu-wrapper d-flex align-items-center w-100">
                <button type="button"
                        class="lab-menu-btn"
                        id="labSidebarToggle"
                        data-lab-sidebar-toggle
                        aria-label="إظهار أو إخفاء القائمة"
                        aria-controls="sidebar"
                        aria-expanded="true">
                    <i class="mdi mdi-menu" aria-hidden="true"></i>
                </button>
                <a class="lab-top-brand" asp-controller="Admin" asp-action="Index">
                    <img src="~/img/lab-logo.svg" alt="" class="lab-brand-icon" />
                    <span class="lab-brand-text">حد السيف</span>
                </a>
                <ul class="navbar-nav navbar-nav-right me-auto">
                    <li class="nav-item nav-profile dropdown">
                        <a class="nav-link dropdown-toggle" id="profileDropdown" href="#" data-toggle="dropdown" aria-expanded="false">
                            @{
                                var userProfile = _userProfile.Repository.GetWhere(a => a.UserId == _userManager.GetUserId(User)).FirstOrDefault();
                                if (userProfile != null)
                                {
                                    <div class="nav-profile-img">
                                        <img src="~/upload/@userProfile.ImageUrl" alt="no img" />
                                    </div>
                                    <div class="nav-profile-text">
                                        <p class="mb-1 text-black">@userProfile.DisplayName</p>
                                    </div>
                                    ViewBag.ImageUrl = userProfile.ImageUrl;
                                }
                                else
                                {
                                    <div class="nav-profile-img">
                                        <img src="~/img/user.png" alt="no img" />
                                    </div>
                                    <div class="nav-profile-text">
                                        <p class="mb-1 text-black">@User.Identity?.Name</p>
                                    </div>
                                }
                            }
                        </a>
                        <div class="dropdown-menu navbar-dropdown p-2" aria-labelledby="profileDropdown">
                            <a class="dropdown-item" asp-action="UserProfile" asp-controller="Account" asp-route-userId="@_userManager.GetUserId(User)">الملف الشخصي</a>
                            <a class="dropdown-item" asp-action="ChangePassword" asp-controller="Account">تغيير كلمة المرور</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" asp-action="Logout" asp-controller="Account">تسجيل الخروج</a>
                        </div>
                    </li>
                </ul>
            </div>
        </nav>

        <div class="container-fluid page-body-wrapper">
            <nav class="sidebar sidebar-offcanvas" id="sidebar">
                <ul class="nav">
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Admin")" class="nav-link">
                            <span class="icon-bg"><i class="mdi mdi-view-dashboard menu-icon"></i></span>
                            <span class="menu-title">لوحة التحكم</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "LabCases")" class="nav-link">
                            <span class="icon-bg"><i class="bi bi-journal-medical menu-icon"></i></span>
                            <span class="menu-title">الحالات</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Ledger")" class="nav-link">
                            <span class="icon-bg"><i class="bi bi-book menu-icon"></i></span>
                            <span class="menu-title">سجل الصندوق</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Doctors")" class="nav-link">
                            <span class="icon-bg"><i class="bi bi-person-badge menu-icon"></i></span>
                            <span class="menu-title">الأطباء</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Clinics")" class="nav-link">
                            <span class="icon-bg"><i class="bi bi-hospital menu-icon"></i></span>
                            <span class="menu-title">العيادات</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "ServiceTypes")" class="nav-link">
                            <span class="icon-bg"><i class="bi bi-tag menu-icon"></i></span>
                            <span class="menu-title">المنتجات والأسعار</span>
                        </a>
                    </li>
                    @if (User.IsInRole("Prog") || User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" data-toggle="collapse" href="#finance" aria-expanded="false">
                                <span class="icon-bg"><i class="bi bi-cash-coin menu-icon"></i></span>
                                <span class="menu-title">المالية</span>
                                <i class="menu-arrow"></i>
                            </a>
                            <div class="collapse" id="finance">
                                <ul class="nav flex-column sub-menu">
                                    <li class="nav-item"><a href="@Url.Action("Index", "Finance")" class="nav-link">الأرباح والخسائر</a></li>
                                    <li class="nav-item"><a href="@Url.Action("Index", "Invoices")" class="nav-link">الفواتير</a></li>
                                    <li class="nav-item"><a href="@Url.Action("Index", "Income")" class="nav-link">الإيرادات</a></li>
                                    <li class="nav-item"><a href="@Url.Action("Index", "Expenses")" class="nav-link">المصاريف</a></li>
                                    <li class="nav-item"><a href="@Url.Action("Index", "Loans")" class="nav-link">السلف</a></li>
                                    <li class="nav-item"><a href="@Url.Action("Index", "Accounts")" class="nav-link">الحسابات</a></li>
                                    <li class="nav-item"><a href="@Url.Action("Receivables", "Finance")" class="nav-link">ذمم المراكز</a></li>
                                    <li class="nav-item"><a href="@Url.Action("Remakes", "Finance")" class="nav-link">الإعادات</a></li>
                                </ul>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "DoctorPrices")" class="nav-link">
                                <span class="icon-bg"><i class="bi bi-percent menu-icon"></i></span>
                                <span class="menu-title">أسعار الأطباء</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-toggle="collapse" href="#users" aria-expanded="false">
                                <span class="icon-bg"><i class="bi bi-people menu-icon"></i></span>
                                <span class="menu-title">المستخدمون</span>
                                <i class="menu-arrow"></i>
                            </a>
                            <div class="collapse" id="users">
                                <ul class="nav flex-column sub-menu">
                                    <li class="nav-item"><a href="@Url.Action("Index", "Users")" class="nav-link">المستخدمون</a></li>
                                    <li class="nav-item"><a href="@Url.Action("Index", "Roles")" class="nav-link">الصلاحيات</a></li>
                                    <li class="nav-item"><a href="@Url.Action("Index", "Employees")" class="nav-link">الموظفون</a></li>
                                </ul>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-toggle="collapse" href="#settings" aria-expanded="false">
                                <span class="icon-bg"><i class="bi bi-gear menu-icon"></i></span>
                                <span class="menu-title">الإعدادات</span>
                                <i class="menu-arrow"></i>
                            </a>
                            <div class="collapse" id="settings">
                                <ul class="nav flex-column sub-menu">
                                    <li class="nav-item"><a href="@Url.Action("SiteDetails", "Admin")" class="nav-link">بيانات المختبر</a></li>
                                    <li class="nav-item"><a href="@Url.Action("ImportArchive", "Admin")" class="nav-link">استيراد الأرشيف</a></li>
                                    <li class="nav-item"><a href="@Url.Action("ImportFinance", "Admin")" class="nav-link">استيراد الماليات</a></li>
                                </ul>
                            </div>
                        </li>
                    }
                    <li class="nav-item sidebar-user-actions">
                        <div class="sidebar-user-menu">
                            <a href="@Url.Action("Logout", "Account")" class="nav-link">
                                <i class="mdi mdi-logout menu-icon"></i>
                                <span class="menu-title">تسجيل الخروج</span>
                            </a>
                        </div>
                    </li>
                </ul>
            </nav>

            <div class="main-panel">
                <div class="page-content">
                    @RenderBody()
                </div>
                <footer class="footer">
                    <div class="footer-inner-wraper">
                        <div class="d-flex justify-content-center">
                            &copy; @DateTime.Now.Year - @ViewBag.SiteName
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <script src="~/assets1/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/assets1/js/misc.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/dashboard-ui.js" asp-append-version="true"></script>
    <partial name="Partial/_toast" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
