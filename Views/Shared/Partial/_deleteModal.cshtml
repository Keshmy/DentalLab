@model Guid?

<div class="modal fade" id="DeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">هل أنت متأكد من الحذف؟</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">إغلاق</button>
                @if (Model.HasValue)
                {
                    <form asp-action="Delete" asp-route-id="@Model.Value" method="post" class="d-inline">
                        <button type="submit" class="btn btn-danger">حذف</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
