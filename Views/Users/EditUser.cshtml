@model EditUserVM
@{ ViewData["Title"] = "تعديل مستخدم"; }

<div class="row">
    <div class="col-md-6">
        <h4>تعديل المستخدم</h4>
        <form asp-action="EditUser" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control" /></div>
            <div class="mb-3"><label asp-for="Age"></label><input asp-for="Age" class="form-control" /></div>
            <p>الاسم الظاهر: @Model.DisplayName</p>
            <p>تاريخ الإنشاء: @Model.CreatedDateLocalTime</p>
            <p>آخر دخول: @Model.LastAccessTimeLocalTime</p>
            <button class="btn btn-primary">حفظ</button>
        </form>
        <form asp-action="LockoutUser" method="post" class="mt-2 d-inline">
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-warning">@(Model.LockoutEnd > DateTimeOffset.UtcNow ? "إلغاء الإيقاف" : "إيقاف")</button>
        </form>
        <form asp-action="DeleteUser" method="post" class="mt-2 d-inline" onsubmit="return confirm('حذف المستخدم؟');">
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-danger">حذف</button>
        </form>
    </div>
    <div class="col-md-6">
        <h4>الصلاحيات</h4>
        @await Component.InvokeAsync("UserRoles", new { userId = Model.Id })
    </div>
</div>
