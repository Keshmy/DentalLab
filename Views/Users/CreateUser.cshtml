@model CreateUserVM
@{ ViewData["Title"] = "مستخدم جديد"; }
<form asp-action="CreateUser" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Age"></label><input asp-for="Age" class="form-control" /></div>
    <div class="mb-3">
        <label asp-for="RoleId"></label>
        <select asp-for="RoleId" class="form-select" asp-items="ViewBag.Roles">
            <option value="">اختر الصلاحية</option>
        </select>
    </div>
    <button class="btn btn-primary">إنشاء</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
