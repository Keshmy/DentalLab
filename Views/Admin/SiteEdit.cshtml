@model SiteInfo
@{
    ViewData["Title"] = "تعديل بيانات المختبر";
}
<h4 class="mb-3">بيانات المختبر</h4>
<form asp-action="SiteEdit" method="post" enctype="multipart/form-data" class="col-lg-8">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="LogoUrl" />

    <div class="card mb-3">
        <div class="card-header"><strong>عام</strong></div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Activity" class="form-label"></label>
                <input asp-for="Activity" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="About" class="form-label"></label>
                <textarea asp-for="About" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-md-6">
                <label asp-for="Logo" class="form-label"></label>
                <input asp-for="Logo" type="file" class="form-control" accept="image/*" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"><strong>بيانات الحساب المصرفي (تظهر في الفاتورة)</strong></div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label asp-for="BankAccountName" class="form-label"></label>
                <input asp-for="BankAccountName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="BankName" class="form-label"></label>
                <input asp-for="BankName" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="BankAccountNumber" class="form-label"></label>
                <input asp-for="BankAccountNumber" class="form-control" dir="ltr" />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"><strong>نسبة الشريك</strong></div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label asp-for="PartnerName" class="form-label"></label>
                <input asp-for="PartnerName" class="form-control" placeholder="مثال: عياد" />
            </div>
            <div class="col-md-6">
                <label asp-for="PartnerSharePercent" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="PartnerSharePercent" class="form-control" />
                    <span class="input-group-text">٪</span>
                </div>
                <span asp-validation-for="PartnerSharePercent" class="text-danger"></span>
            </div>
            <div class="col-12">
                <div class="alert alert-light border mb-0 small">
                    النسبة تُحسب من <strong>الربح قبل النسبة</strong> (الإيراد − المصروفات التشغيلية − الديون المعدومة)،
                    ولا تُحسب عند الخسارة. ولذلك لا تُدخل نسبة الشريك كمصروف يدوي أيضاً وإلا احتُسبت مرتين.
                </div>
            </div>
        </div>
    </div>

    <button class="btn btn-primary px-5">حفظ</button>
    <a asp-action="SiteDetails" class="btn btn-outline-secondary">رجوع</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
