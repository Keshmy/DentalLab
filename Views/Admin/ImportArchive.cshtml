@{
    ViewData["Title"] = "استيراد الأرشيف";
}
<div class="card p-4 col-md-8">
    <h4>استيراد أرشيف الحالات من Excel</h4>
    <p class="text-muted">
        اختر ملف الأرشيف (Excel) من جهازك. سيتم استيراد ورقة الأسعار وحالات 2025 و 2026 منه.
        الحالات الموجودة مسبقاً (نفس رقم الحالة والسنة) يتم تخطيها.
    </p>

    <div class="alert alert-warning">
        <strong>تنبيه:</strong> الاستيراد يضيف حالات وأطباء وعيادات ومنتجات جديدة إلى قاعدة البيانات،
        ولا يمكن التراجع عنه من الواجهة. خذ نسخة احتياطية قبل الاستيراد.
    </div>

    <div asp-validation-summary="All" class="text-danger mb-2"></div>

    <form asp-action="ImportArchive" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="file" class="form-label">ملف الأرشيف</label>
            <input type="file" id="file" name="file" class="form-control"
                   accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
            <div class="form-text">صيغة .xlsx فقط.</div>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="confirm" name="confirm" value="true" required />
            <label class="form-check-label" for="confirm">
                أفهم أن البيانات الموجودة في هذا الملف ستُضاف إلى قاعدة البيانات.
            </label>
        </div>
        <button class="btn btn-primary">بدء الاستيراد</button>
        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
    </form>
</div>
